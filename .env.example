ENV=development
APP_NAME=golang-clean-architecture-starter
APP_PORT=3000

LOG_LEVEL=debug
LOG_OUTPUT=stdout

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=dev_gca

# Comma-separated list of allowed origins. "*" is fine in development;
# the app refuses to boot in production when this is "*".
CORS_ALLOWED_ORIGINS=*
